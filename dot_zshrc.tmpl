() {
  local _nvim_os _nvim_arch
  case "$(uname -s)" in
    Linux)  _nvim_os="linux" ;;
    Darwin) _nvim_os="macos" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  _nvim_arch="x86_64" ;;
    aarch64|arm64) _nvim_arch="arm64" ;;
  esac

  zinit ice from"gh-r" as"program" bpick"*${_nvim_os}*${_nvim_arch}*.tar.gz" pick"**/bin/nvim"
  zinit light neovim/neovim
}

setopt promptsubst

# bun — add to fpath before compinit so _bun autloads from the cached compdump
# (compinit runs at the fast-syntax-highlighting atinit below). Avoids sourcing
# the 46KB _bun file on every shell startup.
fpath=("$HOME/.bun" $fpath)

# Override zicompinit to use -C (cache-only mode). The default zicompinit runs
# compinit without -C, which rebuilds the ~370KB compdump cache on every shell
# startup (~525ms). -C skips the security audit (compaudit) and trusts the
# cached dump, cutting compinit from ~525ms to ~16ms.
# If completion issues appear after adding/removing plugins, run:
#   rm -f ~/.zcompdump && zsh -c 'source ~/.zshrc'
# to rebuild the cache once.
zicompinit() {
  autoload -Uz compinit
  compinit -C -d ${ZINIT[ZCOMPDUMP_PATH]:-${ZDOTDIR:-$HOME}/.zcompdump} "${(Q@)${(z@)ZINIT[COMPINIT_OPTS]}}"
}


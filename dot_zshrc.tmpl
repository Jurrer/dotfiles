_zinit_zsh="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git/zinit.zsh"
[[ ! -r "$_zinit_zsh" && -r "$HOME/.config/local/share/zinit/zinit.git/zinit.zsh" ]] && _zinit_zsh="$HOME/.config/local/share/zinit/zinit.git/zinit.zsh"

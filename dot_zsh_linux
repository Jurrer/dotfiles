[ -f /opt/anaconda/etc/profile.d/conda.sh ] && source /opt/anaconda/etc/profile.d/conda.sh
export CRYPTOGRAPHY_OPENSSL_NO_LEGACY=true
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/cuda/lib64:/usr/lib
export CUDA_HOME=/opt/cuda


# +----------+
# | crowdsec |
# +----------+
alias cscli="docker exec -t crowdsec cscli"

# iotop errors with "setupterm: could not find terminal" when $TERM (e.g. xterm-ghostty)
# has no terminfo entry on this machine
alias iotop="TERM=xterm-256color sudo iotop"

# +----------+
# | Personal |
# +----------+

wu() {
    if [[ -n $1 ]]; then
        sudo wg-quick up wg$1
    else
        echo "Usage: wu <X> (where X is the WireGuard interface number)"
    fi
}
wd() {
    if [[ -n $1 ]]; then
        sudo wg-quick down wg$1
    else
        echo "Usage: wd <X> (where X is the WireGuard interface number)"
    fi
}


